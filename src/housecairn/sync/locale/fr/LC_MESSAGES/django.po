msgid ""
msgstr ""
"Project-Id-Version: HouseCairn\n"
"Report-Msgid-Bugs-To: \n"
"Language-Team: French\n"
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "This home was erased."
msgstr "Ce logement a été effacé."

msgid "This position is older than the oldest change kept: read the snapshot."
msgstr "Cette position est plus ancienne que la plus ancienne modification conservée : lisez l'instantané."

#, python-format
msgid "%(name)s is a whole number, 0 or more."
msgstr "%(name)s est un nombre entier, 0 ou plus."

msgid "The body is not a home."
msgstr "Le contenu n'est pas un logement."

msgid "The body is not JSON."
msgstr "Le contenu n'est pas du JSON."

msgid "The body is a JSON object."
msgstr "Le contenu est un objet JSON."

msgid "id is a UUID in its canonical text form."
msgstr "id est un UUID sous sa forme textuelle canonique."

#, python-format
msgid "%(name)s is a text."
msgstr "%(name)s est un texte."

msgid "A field of the home is not valid."
msgstr "Un champ du logement n'est pas valide."

msgid "This connection may not create homes."
msgstr "Cette connexion ne peut pas créer de logements."

msgid "This id is already taken."
msgstr "Cet identifiant est déjà pris."

msgid "limit is 1 or more."
msgstr "limit vaut 1 ou plus."

msgid "This position is beyond the last change of the home."
msgstr "Cette position est au-delà de la dernière modification du logement."

msgid "This push number was used with another body."
msgstr "Ce numéro de push a déjà servi avec un autre contenu."

#, python-format
msgid "A push holds at most %(ops)s operations and %(bytes)s bytes."
msgstr "Un push contient au plus %(ops)s opérations et %(bytes)s octets."

#, python-format
msgid "%(name)s is a whole number."
msgstr "%(name)s est un nombre entier."

msgid "device is a device id, 22 characters of base64url."
msgstr "device est un identifiant d'appareil, 22 caractères en base64url."

msgid "device is the server's own device id."
msgstr "device est l'identifiant d'appareil du serveur lui-même."

msgid "This connection pushes with another device id."
msgstr "Cette connexion envoie avec un autre identifiant d'appareil."

msgid "This device id belongs to another connection."
msgstr "Cet identifiant d'appareil appartient à une autre connexion."

msgid "ops is a list of operations."
msgstr "ops est une liste d'opérations."

msgid "This version of the app reads but does not write: update it."
msgstr "Cette version de l'application lit mais n'écrit pas : mettez-la à jour."

#, python-format
msgid "A file holds at most %(bytes)s bytes."
msgstr "Un fichier contient au plus %(bytes)s octets."

msgid "HC-Sha256 is the SHA-256 of the file, 64 lower-case hexadecimal digits."
msgstr "HC-Sha256 est le SHA-256 du fichier, 64 chiffres hexadécimaux en minuscules."

msgid "The file is empty."
msgstr "Le fichier est vide."

msgid "The body is the file itself, sent as application/octet-stream or its own type."
msgstr "Le corps est le fichier lui-même, envoyé en application/octet-stream ou sous son propre type."

msgid "HC-Sha256 is not the SHA-256 of the bytes received."
msgstr "HC-Sha256 n’est pas le SHA-256 des octets reçus."

msgid "A read-only member sends no file."
msgstr "Un membre en lecture seule n’envoie aucun fichier."

msgid "This file id is already taken by other bytes."
msgstr "Cet identifiant de fichier est déjà pris par d’autres octets."

msgid "size is thumbnail, or left out."
msgstr "size vaut thumbnail, ou est omis."

#, python-format
msgid "%(name)s of a file is a whole number."
msgstr "%(name)s d’un fichier est un nombre entier."

msgid "A file is a reference: file, sha256, size and type."
msgstr "Un fichier est une référence : file, sha256, size et type."

msgid "file is a UUID in its canonical text form."
msgstr "file est un UUID sous sa forme textuelle canonique."

msgid "sha256 is 64 lower-case hexadecimal digits."
msgstr "sha256 compte 64 chiffres hexadécimaux en minuscules."

msgid "type of a file is a media type."
msgstr "type d’un fichier est un type de média."

#, python-format
msgid "%(name)s is a UUID in its canonical text form."
msgstr "%(name)s est un UUID sous sa forme textuelle canonique."

msgid "A text holds a NUL character."
msgstr "Un texte contient un caractère NUL."

msgid "A text is not valid Unicode."
msgstr "Un texte n'est pas de l'Unicode valide."

#, python-format
msgid "A value is nested more than %(depth)s deep."
msgstr "Une valeur est imbriquée sur plus de %(depth)s niveaux."

msgid "An operation is a JSON object."
msgstr "Une opération est un objet JSON."

msgid "t is an entity type, <app>.<model> in lower case."
msgstr "t est un type d'entité, <app>.<model> en minuscules."

msgid "k is put, delete or restore."
msgstr "k vaut put, delete ou restore."

msgid "c is a clock, 16 lower-case hexadecimal digits."
msgstr "c est une horloge, 16 chiffres hexadécimaux en minuscules."

msgid "A put sets at least one field in f."
msgstr "Un put écrit au moins un champ dans f."

msgid "A delete or a restore sets no field."
msgstr "Un delete ou un restore n'écrit aucun champ."

msgid "A field is named in lower case, at most 64 characters."
msgstr "Un champ est nommé en minuscules, en 64 caractères au plus."

msgid "deleted_at is written by a delete or a restore."
msgstr "deleted_at s'écrit par un delete ou un restore."

msgid "An instant is an HLC, 16 hexadecimal digits."
msgstr "Un instant est une HLC, 16 chiffres hexadécimaux."

msgid "An instant is beyond the dates the server keeps."
msgstr "Cet instant dépasse les dates que le serveur conserve."

#, python-format
msgid "%(name)s cannot be empty."
msgstr "%(name)s ne peut pas être vide."

#, python-format
msgid "%(name)s is true or false."
msgstr "%(name)s vaut true ou false."

#, python-format
msgid "%(name)s is an amount, a decimal string."
msgstr "%(name)s est un montant, une chaîne décimale."

#, python-format
msgid "%(name)s is a date, YYYY-MM-DD."
msgstr "%(name)s est une date, AAAA-MM-JJ."

#, python-format
msgid "%(name)s cannot be written by a push."
msgstr "%(name)s ne peut pas être écrit par un push."

#, python-format
msgid "%(name)s is not a valid value."
msgstr "%(name)s n'est pas une valeur valide."

msgid "This operation breaks a rule of the data."
msgstr "Cette opération enfreint une règle des données."

#, python-format
msgid "A new row needs %(fields)s."
msgstr "Une nouvelle ligne a besoin de %(fields)s."

#, python-format
msgid "A row keeps at most %(fields)s fields the server does not know, %(bytes)s bytes together."
msgstr "Une ligne garde au plus %(fields)s champs inconnus du serveur, %(bytes)s octets en tout."

msgid "A link names both of its rows."
msgstr "Un lien nomme ses deux lignes."
