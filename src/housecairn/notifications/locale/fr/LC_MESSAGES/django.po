#, python-format
msgid "%(title)s, %(home)s, due %(date)s"
msgstr "%(title)s, %(home)s, pour le %(date)s"

msgid "HouseCairn reminder"
msgstr "Rappel HouseCairn"

#, python-format
msgid "And %(n)d more."
msgstr "Et %(n)d de plus."

msgid "HouseCairn: tasks to do"
msgstr "HouseCairn : tâches à faire"

msgid "This is not an Apprise address, such as ntfys://ntfy.sh/topic."
msgstr "Ce n'est pas une adresse Apprise, comme ntfys://ntfy.sh/sujet."

msgid "This kind of channel is not offered. Use ntfy, Gotify, Telegram, Signal, Matrix, email, Discord, Slack, Pushover, Mattermost or Apprise API."
msgstr "Ce type de canal n'est pas proposé. Utilisez ntfy, Gotify, Telegram, Signal, Matrix, l'e-mail, Discord, Slack, Pushover, Mattermost ou l'API Apprise."

msgid "These options make the instance read a file: remove them."
msgstr "Ces options font lire un fichier à l'instance : retirez-les."

msgid "Options that add headers or fields to the request (+name, -name, :name) are not accepted: remove them."
msgstr "Les options qui ajoutent des en-têtes ou des champs à la requête (+nom, -nom, :nom) ne sont pas acceptées : retirez-les."

msgid "The instance does not send to this address."
msgstr "L'instance n'envoie pas à cette adresse."

msgid "This address is on a private network, which this instance does not send to. An administrator of the instance can allow it: Settings, Notifications, Channels on the local network."
msgstr "Cette adresse est sur un réseau privé, auquel cette instance n'envoie pas. Un administrateur de l'instance peut l'autoriser : Réglages, Notifications, Canaux sur le réseau local."

msgid "The address of a channel cannot change: delete the channel and add another."
msgstr "L'adresse d'un canal ne peut pas changer : supprimez le canal et ajoutez-en un autre."

msgid "This field cannot be changed."
msgstr "Ce champ ne peut pas être modifié."

msgid "Channel added. Send a test to check it."
msgstr "Canal ajouté. Envoyez un test pour le vérifier."

msgid "Saved."
msgstr "Enregistré."

msgid "Channel deleted."
msgstr "Canal supprimé."

msgid "The test message was sent."
msgstr "Le message de test a été envoyé."

msgid "The test message could not be sent: check the address and the service."
msgstr "Le message de test n'a pas pu être envoyé : vérifiez l'adresse et le service."

msgid "The test message is being sent."
msgstr "Le message de test est en cours d'envoi."

msgid "Notifications are turned off on this instance."
msgstr "Les notifications sont désactivées sur cette instance."

#, python-format
msgid "At most %(n)d channels."
msgstr "%(n)d canaux au plus."

msgid "This channel receives the reminders of your tasks."
msgstr "Ce canal reçoit les rappels de vos tâches."

msgid "Give the start and the end of the quiet hours, or neither."
msgstr "Indiquez le début et la fin des heures calmes, ou aucun des deux."

msgid "Choose a time zone such as Europe/Paris."
msgstr "Choisissez un fuseau horaire comme Europe/Paris."

msgid "The result appears here in a few seconds."
msgstr "Le résultat s'affiche ici dans quelques secondes."

msgid "Reload this page in a moment to see the result."
msgstr "Rechargez cette page dans un instant pour voir le résultat."

#, python-format
msgid "%(service)s (%(scheme)s). The address is kept encrypted and is never shown again: to change it, delete this channel and add another."
msgstr "%(service)s (%(scheme)s). L'adresse est conservée chiffrée et n'est plus jamais affichée : pour la changer, supprimez ce canal et ajoutez-en un autre."

msgid "Save"
msgstr "Enregistrer"

msgid "Send a test message"
msgstr "Envoyer un message de test"

msgid "Delete the channel"
msgstr "Supprimer le canal"

#, python-format
msgid "Notifications reach this device through the push service of %(service)s. They are encrypted for the device: %(service)s sees when one is sent and its size, not what it says."
msgstr "Les notifications arrivent sur cet appareil par le service push de %(service)s. Elles sont chiffrées pour l'appareil : %(service)s voit quand l'une part et sa taille, pas ce qu'elle dit."

msgid "Send a test notification"
msgstr "Envoyer une notification de test"

msgid "Stop notifications on this device"
msgstr "Arrêter les notifications sur cet appareil"

msgid "Notifications are turned off on this instance: its administrator can turn them on."
msgstr "Les notifications sont désactivées sur cette instance : son administrateur peut les activer."

msgid "Channels"
msgstr "Canaux"

msgid "Where your reminders go. Only you see your channels; their addresses are never shown again."
msgstr "Là où partent vos rappels. Vous seul voyez vos canaux ; leurs adresses ne sont plus jamais affichées."

