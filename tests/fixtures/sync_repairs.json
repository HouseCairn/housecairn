{
  "version": 1,
  "about": "Repair vectors of the rules of mobile ADR 0003 across rows, as a Housecairn server applies them (docs/adr/0077 needs 6 and 7, docs/adr/0079 M5b). Each case applies the operations of `before` in their order, then the pushes of `pushes` in every order, each push as one request of its device; every order gives the fields of `expect.rows` (as the snapshot gives them), the rows of `expect.deleted` deleted, the stock of each article of `expect.stock` (the sum of the effects of its movements) and the number of audit entries of each action of `expect.audit`. Names starting with `$` are ids: `$home` the home, those of `ids` the deterministic ids of mobile ADR 0003 (`[\"next\", occurrence]`, `[\"material\", task, article]`, `[\"draw\", occurrence, article]`), any other a new random UUID. Clocks are on 2026-01-01 from 12:00 UTC, in the past of any server; the clock of a repair is the server's.",
  "devices": {
    "a": "EREREREREREREREREREREQ",
    "b": "7u7u7u7u7u7u7u7u7u7u7g"
  },
  "cases": [
    {
      "name": "closed_on_one_phone_postponed_on_the_other",
      "rule": "two open occurrences: the one that follows stays open",
      "about": "Phone a closes $o1 and makes its successor; phone b, later, postpones $o1. Both are open: $next1 follows $o1 and stays open, $o1 is closed as done since it has a done date.",
      "ids": {
        "$next1": [
          "next",
          "$o1"
        ]
      },
      "before": [
        [
          {
            "device": "a",
            "op": {
              "t": "tasks.task",
              "h": "$home",
              "id": "$task",
              "k": "put",
              "c": "019b796dd9e80000",
              "f": {
                "title": "Clean the filter",
                "repeat_mode": "after_last",
                "repeat_unit": "month",
                "repeat_interval": 1
              }
            }
          },
          {
            "device": "a",
            "op": {
              "t": "tasks.occurrence",
              "h": "$home",
              "id": "$o1",
              "k": "put",
              "c": "019b796dddd00000",
              "f": {
                "task_id": "$task",
                "due_on": "2026-01-10",
                "status": "planned"
              }
            }
          }
        ]
      ],
      "pushes": [
        [
          {
            "device": "a",
            "op": {
              "t": "tasks.occurrence",
              "h": "$home",
              "id": "$o1",
              "k": "put",
              "c": "019b796f5ca00000",
              "f": {
                "status_before": "planned",
                "status": "done",
                "completed_on": "2026-01-12",
                "completion_note": ""
              }
            }
          },
          {
            "device": "a",
            "op": {
              "t": "tasks.occurrence",
              "h": "$home",
              "id": "$next1",
              "k": "put",
              "c": "019b796f60880000",
              "f": {
                "task_id": "$task",
                "due_on": "2026-02-12",
                "status": "planned",
                "status_before": "",
                "postponed_from": null,
                "completed_on": null,
                "completion_note": "",
                "follows_id": "$o1"
              }
            }
          }
        ],
        [
          {
            "device": "b",
            "op": {
              "t": "tasks.occurrence",
              "h": "$home",
              "id": "$o1",
              "k": "put",
              "c": "019b7970e3400000",
              "f": {
                "postponed_from": "2026-01-10",
                "due_on": "2026-01-20",
                "status": "postponed"
              }
            }
          }
        ]
      ],
      "expect": {
        "rows": {
          "$o1": {
            "status": "done",
            "completed_on": "2026-01-12",
            "due_on": "2026-01-20"
          },
          "$next1": {
            "status": "planned",
            "due_on": "2026-02-12",
            "deleted_at": null
          }
        },
        "audit": {
          "occurrence.done": 1
        }
      }
    },
